# Optional process environment settings. The launcher does not load this file.
# Configure these in your shell, or use the in-app AI settings.
AUDIT_AI_PROVIDER=ollama
AUDIT_AI_MODEL=qwen2.5:3b
OLLAMA_HOST=http://127.0.0.1:11434
# Local data directory: defaults to ./data; never commit audit data or secrets.
# AUDIT_DATA_DIR=C:\RaqibData
# Bound the number of AI calls in a run; see the current application limits.
# AUDIT_AI_MAX_REQUESTS=180

# Cloud alternative (optional): configure via the UI instead of these variables.
# AUDIT_AI_PROVIDER=gemini
# AUDIT_AI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=your-key-set-only-on-your-computer
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Contracts/evidence are sent to Google when a Gemini audit starts.
